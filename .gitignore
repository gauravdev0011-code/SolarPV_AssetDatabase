# Python cache files
__pycache__/
*.py[cod]

# Virtual environment
.venv/
venv/

# Local environment settings and secrets
.env
.env.*
!.env.example

# Local databases and backups
*.db
*.sqlite
*.sqlite3
*.db-journal
*.sqlite-wal
*.sqlite-shm
*.bak

# Test and tool output
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Editor and operating system files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local imported and exported data
data/imports/*
!data/imports/.gitkeep
data/exports/*
!data/exports/.gitkeep

# Local research data and generated files
data/raw/
data/private/
*.log